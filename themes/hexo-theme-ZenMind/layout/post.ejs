<div class="post-main">
    <% if (is_post()) { %>
        <!-- 引入必要的CSS和JS库 -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/social-share.js/dist/css/share.min.css">
        <script src="https://cdn.jsdelivr.net/npm/social-share.js/dist/js/social-share.min.js"></script>
        <div class="post-main-title" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;">
            <h1 style="margin: 0; flex: 1; min-width: 200px;"><%= page.title %></h1>
        </div>
        <!-- 分享按钮区 -->
        <div class="share-component" 
             data-sites="weibo,facebook"
             data-weibo-title="<%= page.title %>"
             data-url="<%= decodeURI(page.permalink) %>">
        </div>
        <div class="post-meta">
            <%- date(page.date, "YYYY-MM-DD HH:mm:ss") %> ｜ 
            <% page.categories.forEach(function(category) { %>
                <a href="<%= url_for(category.path) %>"># <%= category.name %></a>
            <% }); %>
        </div>
        <!-- 圆角分类 -->
        <div class="tags">
            <% page.categories.forEach(function(category) { %>
                <a href="<%= url_for(category.path) %>"><%= category.name %></a>
            <% }); %>
        </div>
        <div class="post-md">
            <%- page.content %>
        </div>
        <!-- 评论系统 -->
        <div class="post-comments" style="width: 100%; box-sizing: border-box; margin-top: 3em; padding: 1.5em; background: #f9f9f9; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
            <h3 style="text-align: center; margin-bottom: 1.5em; color: #333; font-weight: 600;">评论区</h3>
            <div style="max-width: 100%; overflow: hidden; border-radius: 4px;">
                <script src="https://utteranc.es/client.js"
                        repo="AKAama/Comments"
                        issue-term="pathname"
                        theme="github-light"
                        crossorigin="anonymous"
                        async>
                </script>
            </div>
        </div>
    <% } else { %>
        <div class="post-md">
            <%- page.content %>
        </div>
    <% } %>
<!-- tags -->
<% if (page.tags && page.tags.length > 0) { %>
    <div class="post-meta">
        标签：
        <% page.tags.forEach(function(tags) { %>
            <a href="<%= url_for(tags.path) %>"> / <%= tags.name %></a>
        <% }); %>
    </div>
<% } %>
</div>